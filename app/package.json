    "sparqljs": "^3.7.3"
  },
  "meteor": {
    "mainModule": {
      "server": "server/platform/main.js"
    },
    "testModule": "tests/main.js"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@types/jquery": "^3.5.32",
    "@types/meteor": "^2.9.8",
